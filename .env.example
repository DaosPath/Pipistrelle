# Pipistrelle local configuration
# Copy this file to .env and fill only the values you actually use.

# Authentication is fail-closed by default.
# Set true only if you intentionally want anonymous MQTT access.
PIPISTRELLE_ALLOW_ANONYMOUS=false
PIPISTRELLE_LOG_LEVEL=info
PIPISTRELLE_MAX_AUTH_CONCURRENCY=4
PIPISTRELLE_CLIENT_QUEUE_CAPACITY=1024
PIPISTRELLE_MAX_SUBSCRIPTIONS_PER_CLIENT=256
PIPISTRELLE_SLOW_CONSUMER_POLICY=backpressure
PIPISTRELLE_SLOW_CONSUMER_TIMEOUT_MS=5000
PIPISTRELLE_BRIDGE_QUEUE_CAPACITY=4096
PIPISTRELLE_BRIDGE_QUEUE_POLICY=drop-newest
PIPISTRELLE_LATENCY_SAMPLE_RATE=64
PIPISTRELLE_WRITER_BATCH_PACKETS=256
PIPISTRELLE_WRITER_BATCH_BYTES=262144
PIPISTRELLE_RECEIVE_MAXIMUM=1024
PIPISTRELLE_MAX_PACKET_SIZE=16777216

# TLS 1.3 crypto: hybrid | pqc-strict | classical
PIPISTRELLE_TLS_PROFILE=hybrid
PIPISTRELLE_BRIDGE_TLS_PROFILE=hybrid

# Optional MQTT bridge. Leave HOST empty to keep bridging disabled.
PIPISTRELLE_BRIDGE_HOST=
PIPISTRELLE_BRIDGE_USER=
PIPISTRELLE_BRIDGE_PASS=
PIPISTRELLE_BRIDGE_PORT=8883
